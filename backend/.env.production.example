FLASK_ENV=production

SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

ACCESS_TOKEN_EXPIRES_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=30

DATABASE_URL=postgresql+psycopg://smartwaste_app:REPLACE_PASSWORD@127.0.0.1:5432/smartwaste_db

FRONTEND_URL=https://app.example.com

MAX_CONTENT_LENGTH_BYTES=5242880

PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=REPLACE_WITH_SERVER_SIDE_SECRET
PAYSTACK_CALLBACK_URL=https://app.example.com/payments/verify

RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
